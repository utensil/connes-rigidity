#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 5 ]]; then
  printf 'usage: %s OPENAI_CHECKOUT REVISION SOURCE_PATH START_LINE END_LINE\n' "$0" >&2
  exit 64
fi

checkout=$1
revision=$2
source_path=$3
start_line=$4
end_line=$5

if [[ ! $start_line =~ ^[0-9]+$ || ! $end_line =~ ^[0-9]+$ || $start_line -gt $end_line ]]; then
  printf 'line range must be START_LINE END_LINE with START_LINE <= END_LINE\n' >&2
  exit 64
fi

git -C "$checkout" cat-file -e "$revision:$source_path"
git -C "$checkout" show "$revision:$source_path" | sed -n "${start_line},${end_line}p"
